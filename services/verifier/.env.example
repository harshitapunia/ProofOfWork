SOLANA_RPC_URL=
VERIFIER_PUBLIC_KEY=
TRUSTED_RUNNER_IMAGE=
PORT=

# Optional, explicit local HTTPS application (original CLI above is unchanged).
# Copy to .env.local in this directory and fill locally. Never commit filled values.
# Canonical HTTPS localhost or 127.0.0.1 origin with your chosen non-privileged port.
APP_ORIGIN=
# Existing browser-trusted certificate and matching TLS key: absolute paths only.
APP_TLS_CERT_FILE=
APP_TLS_KEY_FILE=
# Existing lifecycle SQLite file, absolute path. No records are seeded.
APP_LIFECYCLE_DB=
APP_CHAIN_READS=off
# Optional absolute override; normally leave unset to use this checkout's apps/web/dist.
# APP_WEB_DIST=
